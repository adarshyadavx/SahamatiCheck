<?xml version="1.0" encoding="utf-8"?>
<!-- SahamatiCheck for Android: a thin shell around the SahamatiCheck website (clients are display-only,
     CLAUDE.md rule 5). It adds one native thing: it appears in Android's Share menu, so a Play Store
     listing can be shared straight into a check. It asks for no permission except internet access. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sahamaticheck.app">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <!-- cleartext is allowed so the app can reach a SahamatiCheck server on your own network
             (e.g. http://192.168.1.20:3100); use an https address for anything public -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Play Store: tap ⋮ → Share → SahamatiCheck -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
