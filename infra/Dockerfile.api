# Build from the repo root:  docker build -f infra/Dockerfile.api -t sahamati-api .
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN useradd --create-home --uid 10001 sahamati

COPY backend/core /app/backend/core
COPY backend/worker /app/backend/worker
COPY backend/api /app/backend/api
RUN pip install "/app/backend/core[postgres,redis,html,pdf]" "/app/backend/worker[redis]" /app/backend/api

USER sahamati
ENV SAHAMATI_DATA_DIR=/tmp/sahamati
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz').status==200 else 1)"
CMD ["uvicorn", "sahamati_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
