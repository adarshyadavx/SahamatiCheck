# Build from the repo root:  docker build -f infra/Dockerfile.worker -t sahamati-worker .
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN useradd --create-home --uid 10001 sahamati

COPY backend/core /app/backend/core
COPY backend/worker /app/backend/worker
RUN pip install "/app/backend/core[postgres,redis,html,render,apk]" "/app/backend/worker[redis]"

# Headless Chromium renders JavaScript-only privacy policies (shared path so the app user can use it).
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install --with-deps chromium && chmod -R a+rX /ms-playwright

USER sahamati
ENV SAHAMATI_DATA_DIR=/tmp/sahamati CELERY_EAGER=0
CMD ["celery", "-A", "sahamati_worker.tasks", "worker", "--loglevel=info", "--concurrency=2"]
